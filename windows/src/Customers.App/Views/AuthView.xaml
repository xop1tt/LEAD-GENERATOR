<UserControl
    x:Class="Customers.Ui.AuthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="520" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420" Spacing="20">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <Image Source="Assets/Logo.png" Width="72" Height="72" HorizontalAlignment="Center" />
                    <TextBlock Text="Customers" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Поиск заказов и потенциальных клиентов" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <Border Style="{StaticResource CardStyle}" Padding="24" KeyDown="OnKeyDown">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="StageTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="StageHint" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed" />

                        <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
                        <InfoBar x:Name="InfoBarMessage" Severity="Informational" IsOpen="False" IsClosable="False" />

                        <TextBox x:Name="UsernameBox" Header="Имя пользователя" AutomationProperties.Name="Имя пользователя" />
                        <TextBox x:Name="EmailBox" Header="Электронная почта" InputScope="EmailSmtpAddress" AutomationProperties.Name="Электронная почта" />
                        <TextBox x:Name="CodeBox" Header="Код из письма" PlaceholderText="6 цифр" MaxLength="12" InputScope="Number" AutomationProperties.Name="Код из письма" />
                        <PasswordBox x:Name="PasswordBox" Header="Пароль" AutomationProperties.Name="Пароль" />
                        <PasswordBox x:Name="ConfirmBox" Header="Повторите пароль" AutomationProperties.Name="Повторите пароль" />
                        <TextBlock x:Name="PasswordRules" Style="{StaticResource MutedTextStyle}" />
                        <CheckBox x:Name="RememberBox" Content="Запомнить меня на этом компьютере" />

                        <Button x:Name="PrimaryButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnPrimaryClick" Height="36" />
                        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />

                        <StackPanel Spacing="2" Margin="0,4,0,0">
                            <HyperlinkButton x:Name="LinkOne" Padding="0,4" Click="OnLinkOneClick" />
                            <HyperlinkButton x:Name="LinkTwo" Padding="0,4" Click="OnLinkTwoClick" />
                            <HyperlinkButton x:Name="LinkThree" Padding="0,4" Click="OnLinkThreeClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="OfflineNote" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
