root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xml,csproj,props,targets,xaml,json,yml,yaml,appxmanifest,manifest}]
indent_size = 2

[*.{cs,vb}]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = accessors, anonymous_methods, control_blocks, events, indexers, lambdas, local_functions, methods, properties, types
csharp_indent_case_contents = true

[*.iss]
end_of_line = crlf
